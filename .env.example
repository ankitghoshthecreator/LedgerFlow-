# ─── App ────────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change-me-in-production
DEBUG=true

# ─── Database ────────────────────────────────────────────
# SQLite (default for local dev)
DATABASE_URL=sqlite+aiosqlite:///./ledgerflow.db

# PostgreSQL (uncomment to switch)
# DATABASE_URL=postgresql+asyncpg://ledger:secret@localhost:5432/ledgerflow

# ─── Event Bus ──────────────────────────────────────────
# Options: "in_process" | "kafka"
EVENT_BUS_BACKEND=in_process

# Kafka settings (only used when EVENT_BUS_BACKEND=kafka)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ─── Cache ──────────────────────────────────────────────
# Options: "memory" | "redis"
CACHE_BACKEND=memory
REDIS_URL=redis://localhost:6379/0

# ─── Mock Service Behaviour ─────────────────────────────
CREDIT_BUREAU_FAIL_RATE=0.1        # 0.0 = never fail, 1.0 = always fail
CREDIT_BUREAU_MIN_LATENCY_MS=100
CREDIT_BUREAU_MAX_LATENCY_MS=800
FORCE_KYC_FAIL=false

# ─── MCP Server ─────────────────────────────────────────
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8001
BACKEND_API_URL=http://localhost:8000
